# Copy to .env. Mock mode (the default: `pnpm make "idea"`) needs none of these.
# Live mode (`pnpm make "idea" --live`) needs the keys of the providers you choose below.

# ---- run ------------------------------------------------------------------
# Hard stop for one run, USD. Checked before every paid call (incl. retries).
MAX_COST_USD=3

# ---- script (LLM, structured output) --------------------------------------
# https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=
# Comma-separated chain; on 429/503 the next model is tried.
SCRIPT_MODELS=gemini-3.8-flash,gemini-3.8-flash-lite

# ---- images: character portrait + keyframes -------------------------------
# seedream (BytePlus ARK) | fal-nano-banana | gemini
IMAGE_PROVIDER=seedream
SEEDREAM_MODEL=
SEEDREAM_SIZE=
GEMINI_IMAGE_MODEL=

# ---- video: Seedance 2.0 with native speech -------------------------------
# fal | byteplus
SEEDANCE_TRANSPORT=byteplus
# standard | fast
SEEDANCE_TIER=standard
# BytePlus ModelArk model id (byteplus transport)
SEEDANCE_MODEL=
# BytePlus ModelArk: https://console.byteplus.com/ark
ARK_API_KEY=
ARK_BASE_URL=
# fal.ai (fal transport, fal images, fal lip-sync): https://fal.ai/dashboard/keys
FAL_KEY=

# ---- verbatim gate: speech-to-text ----------------------------------------
# https://console.groq.com/keys (free tier)
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3

# ---- fallback voice (only when native speech fails the gate) --------------
# Order of TTS engines; engines without a key are skipped.
TTS_PROVIDERS=gemini,elevenlabs
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# JSON map "<gender>-<age>" -> voice name, e.g. {"female-young":"Leda"}
GEMINI_TTS_VOICES=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICES=

# ---- fallback lip-sync -----------------------------------------------------
# fal-kling | command
LIPSYNC_PROVIDER=fal-kling
# For `command`: an open-source model run locally, e.g. LatentSync. Placeholders: {video} {audio} {out}
LIPSYNC_CMD=
LIPSYNC_MAX_SECONDS=10

# ---- quality judge (Gemini vision; uses GEMINI_API_KEY) ---------------------
# Comma-separated chain; on 429/503 the next model is tried.
JUDGE_MODELS=gemini-3.8-flash,gemini-2.5-flash
# Pass marks, 1-10. Keyframe below → redrawn with the judge's issues (max 2 extra).
# Clip below → regenerated once, only if MAX_COST_USD allows; otherwise kept with needsReview.
KEYFRAME_MIN=7
CLIP_MIN=5
