# Copy to .env. Mock mode (default) needs none of these.

# Script writer + quality judge (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Image, video, lip-sync models: https://fal.ai/dashboard/keys
FAL_KEY=
# Voice (TTS): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Speech-to-text for the verbatim gate (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Hard stop for one run, USD
MAX_COST_USD=3
