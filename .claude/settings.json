{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production)", "Edit(./.env)", "Write(./.env)", "Edit(./.claude/hooks/**)", "Edit(./scripts/verify.sh)", "Edit(./scripts/harness.sh)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-spend.sh\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.sh\"", "timeout": 600 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.sh\"", "timeout": 600 }] }
    ]
  }
}
